pipeline {
    agent any

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "Preparing for the test environment"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('List Files') {
            steps {
                sh 'ls -R'  // List files in the workspace to check the directory structure
            }
        }

        stage('Test Build') {
            steps {
                script {
                    echo "Running build for the TEST environment"
                    // Ensure the correct file path
                    def groovyScript = load 'testBuild.groovy'  // Correct path for your file
                    groovyScript.build()  // Assuming 'build' is a method in your 'testBuild.groovy' file
                }
            }
        }

        stage('Test Execution') {
            steps {
                script {
                    echo "Running tests for the TEST environment"
                    def groovyScript = load 'testTest.groovy'  // Ensure the test script exists and is loaded properly
                    groovyScript.runTests()
                }
            }
        }

        stage('Deploy to Test') {
            steps {
                script {
                    echo "Deploying to the TEST environment"
                    def groovyScript = load 'testDeploy.groovy'  // Ensure the deploy script exists and is loaded properly
                    groovyScript.deploy()
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up after the build"
        }
        success {
            echo "Build completed successfully for the test environment"
        }
        failure {
            echo "Build failed for the test environment"
        }
    }
}

pipeline {
    agent any

    environment {
        // Set the environment to 'dev' (could also be parameterized or set dynamically)
        ENVIRONMENT = 'dev'
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    echo "Preparing for the ${ENVIRONMENT} environment"
                    // Additional setup, validation, or configuration can go here
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm  // This will checkout the repository code
            }
        }

        stage('Dev Build') {
            when {
                expression { return ENVIRONMENT == 'dev' }
            }
            steps {
                script {
                    echo "Running build for the DEV environment"
                    // Load and execute the Groovy script for the dev build
                    def groovyScript = load 'devBuild.groovy'
                    groovyScript.build()  // Call the 'build' method from the Groovy script
                }
            }
        }

        stage('Dev Test') {
            when {
                expression { return ENVIRONMENT == 'dev' }
            }
            steps {
                script {
                    echo "Running tests in the DEV environment"
                    // Load and execute the Groovy script for running tests
                    def groovyScript = load 'devTest.groovy'
                    groovyScript.runTests()  // Call the 'runTests' method from the Groovy script
                }
            }
        }

        stage('Deploy to Dev') {
            when {
                expression { return ENVIRONMENT == 'dev' }
            }
            steps {
                script {
                    echo "Deploying to the DEV environment"
                    // Load and execute the Groovy script for deployment
                    def groovyScript = load 'devDeploy.groovy'
                    groovyScript.deploy()  // Call the 'deploy' method from the Groovy script
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning up after the build"
            // Perform any cleanup tasks, like archiving artifacts, cleaning workspace, etc.
        }
        success {
            echo "Build completed successfully for the ${ENVIRONMENT} environment"
        }
        failure {
            echo "Build failed for the ${ENVIRONMENT} environment"
        }
    }
}
